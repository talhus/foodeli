# ==============================================================================
# Foodeli Environment Configuration Template
# ==============================================================================

# Server
SERVER_ENV=development
SERVER_PORT=8080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=foodeli
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=foodeli_db
DATABASE_URL=postgres://foodeli:your_postgres_password@localhost:5432/foodeli_db?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=foodeli.events

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION_HOURS=72

# Frontend (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# TyrFintech B2B Payment Gateway Integration
TYRFINTECH_URL=http://localhost:8081
TYRFINTECH_API_KEY=your_tyrfintech_api_key_here
TYRFINTECH_CALLBACK_URL=http://localhost:3000/orders/callback
TYRFINTECH_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/tyrfintech
